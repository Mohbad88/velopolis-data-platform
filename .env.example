# ---------------------------------------------------------------------
# Copier ce fichier en .env et renseigner les valeurs réelles.
# .env n'est JAMAIS versionné (cf. .gitignore).
# ---------------------------------------------------------------------

# --- Base cible du projet --------------------------------------------
# Production :
# DB_URL=postgresql://velopolis:motdepasse@localhost:5432/velopolis_socle
# Mode démonstration (aucune infrastructure) :
DB_URL=sqlite:///data/velopolis_socle.db

# --- Source : base transactionnelle (réplica en lecture) --------------
# SOURCE_DB_URL=postgresql://lecteur:motdepasse@replica:5432/velopolis_source
SOURCE_DB_URL=sqlite:///data/velopolis_source.db

# --- Source : API des boîtiers IoT ------------------------------------
IOT_API_URL=http://127.0.0.1:8001/iot/api/v1/telemetry
IOT_API_TOKEN=jeton-de-test-iot
IOT_PAGE_SIZE=500

# --- Source : API météo publique --------------------------------------
METEO_API_URL=http://127.0.0.1:8001/meteo/api/v1/weather

# --- Source : fichiers CSV du prestataire de maintenance --------------
MAINTENANCE_DIR=mock/data/maintenance

# --- Source : site public du concurrent (scraping) --------------------
CONCURRENT_URL=http://127.0.0.1:8001/concurrent/tarifs
CONCURRENT_ROBOTS_URL=http://127.0.0.1:8001/concurrent/robots.txt
CONCURRENT_USER_AGENT=VelopolisDataBot/1.0 (+contact: dsi@velopolis.fr)
CONCURRENT_DELAI_S=2

# --- Source : entrepôt Hive -------------------------------------------
# HIVE_HOST=hive.velopolis.interne      # vide = lecture des fichiers de l'entrepôt
HIVE_PORT=10000
HIVE_DATABASE=velopolis
HIVE_TABLE=gps_traces
HIVE_WAREHOUSE_DIR=mock/warehouse

# --- API REST ---------------------------------------------------------
# À remplacer par une valeur aléatoire de 32 octets : openssl rand -hex 32
API_SECRET=secret-de-developpement-a-remplacer
API_TOKEN_DUREE_MIN=60
CLIENT_DASHBOARD_SECRET=dashboard-dev
CLIENT_ANALYSTE_SECRET=analyste-dev
CLIENT_SUPERVISION_SECRET=supervision-dev

# --- RGPD -------------------------------------------------------------
# Clé de pseudonymisation : conservée dans le coffre-fort de la DSI,
# jamais dans la base ni dans le dépôt.
RGPD_SALT=sel-de-developpement
RETENTION_TELEMETRIE_JOURS=30
RETENTION_LOCATION_MOIS=13

# --- Fenêtre d'extraction ---------------------------------------------
FENETRE_DEBUT=2026-05-11T00:00:00Z
FENETRE_FIN=2026-05-16T00:00:00Z
